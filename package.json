    "test:auth": "node --test --test-timeout=120000 tests/auth.test.mjs tests/auth.devices.test.mjs",
    "lint:client": "node scripts/lint-client.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  }
