{
  "name": "quan-ly-kho-local",
  "version": "2.15.6",
  "private": true,
  "type": "module",
  "description": "Quản Lý Kho — app một người dùng, chạy local bằng Docker và SQLite",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-timeout=120000 tests/server.test.mjs",
